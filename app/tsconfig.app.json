{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* FIX: Change to "bundler" to match Vite's expectation */
    "moduleResolution": "bundler",

    "jsx": "react-jsx",
    "noEmit": true,
    "strict": true
  },
  "include": ["src"]
}
